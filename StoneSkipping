    crownIcon.Text = "\240\159\145\145" -- 👑
    crownIcon.TextSize = 13
    crownIcon.Font = Enum.Font.GothamBold
    crownIcon.Parent = badgeContainer

    local labelStreet = Instance.new("TextLabel")
    labelStreet.Name = "StreetText"
    labelStreet.Size = UDim2.new(1, 0, 0, 11)
    labelStreet.Position = UDim2.new(0, 0, 0, 22)
    labelStreet.BackgroundTransparency = 1
    labelStreet.Text = "STREET"
    labelStreet.TextColor3 = Color3.fromRGB(255, 255, 255)
    labelStreet.TextSize = 9
    labelStreet.Font = Enum.Font.GothamBold
    labelStreet.Parent = badgeContainer

    local labelHub = Instance.new("TextLabel")
    labelHub.Name = "HubText"
    labelHub.Size = UDim2.new(1, 0, 0, 11)
    labelHub.Position = UDim2.new(0, 0, 0, 33)
    labelHub.BackgroundTransparency = 1
    labelHub.Text = "HUB"
    labelHub.TextColor3 = Color3.fromRGB(255, 45, 55)
    labelHub.TextSize = 10
    labelHub.Font = Enum.Font.GothamBlack
    labelHub.Parent = badgeContainer

    -- Texture Layer for valid Image Asset
    local logoAsset = GetStreetHubLogo()
    local icon = Instance.new("ImageLabel")
    icon.Name = "Icon"
    icon.Size = UDim2.fromScale(0.9, 0.9)
    icon.Position = UDim2.fromScale(0.5, 0.5)
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    icon.BackgroundTransparency = 1
    icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    icon.ScaleType = Enum.ScaleType.Fit
    icon.ZIndex = 3
    icon.Parent = btn

    local iconCorner = Instance.new("UICorner")
    iconCorner.CornerRadius = UDim.new(1, 0)
    iconCorner.Parent = icon

    if logoAsset and logoAsset ~= "" then
        icon.Image = logoAsset
        icon.Visible = true
    else
        icon.Visible = false
    end

    local lastToggle = 0
    local isHubOpen = true

    local function ToggleHub()
        local now = os.clock()
        if now - lastToggle < 0.35 then return end
        lastToggle = now

        isHubOpen = not isHubOpen

        local currentGui = _G.StoneSkippingGui or (Fluent and Fluent.GUI) or (win.Root and win.Root:FindFirstAncestorOfClass("ScreenGui"))
        if currentGui then
            currentGui.Enabled = isHubOpen
        end
        if win.Root then
            win.Root.Visible = isHubOpen
        end

        -- Ensure background blur / DepthOfField never stays on screen
        pcall(function()
            if Fluent and Fluent.ToggleAcrylic then
                Fluent:ToggleAcrylic(false)
            end
            local dof = game:GetService("Lighting"):FindFirstChildOfClass("DepthOfFieldEffect")
            if dof then
                dof.Enabled = false
            end
        end)

        -- Smooth status transition
        TweenService:Create(stroke, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Color = isHubOpen and Color3.fromRGB(255, 45, 55) or Color3.fromRGB(80, 80, 90)
        }):Play()

        TweenService:Create(icon, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            ImageTransparency = isHubOpen and 0 or 0.45
        }):Play()

        TweenService:Create(labelHub, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            TextTransparency = isHubOpen and 0 or 0.45
        }):Play()

        TweenService:Create(labelStreet, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            TextTransparency = isHubOpen and 0 or 0.45
        }):Play()

        -- Punchy spring bounce feedback
        TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(53, 53)
        }):Play()
        task.delay(0.12, function()
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(50, 50)
            }):Play()
        end)
    end

    -- Ultra-responsive Drag & Tap Engine for Mobile & PC
    local isDragging = false
    local dragStartPos = nil
    local startButtonPos = nil
    local movedFar = false
    local pressStartTime = 0

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            movedFar = false
            dragStartPos = input.Position
            startButtonPos = btn.Position
            pressStartTime = os.clock()

            TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(45, 45)
            }):Play()
        end
    end)

    btn.MouseEnter:Connect(function()
        if not isDragging then
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(52, 52)
            }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if not isDragging then
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(50, 50)
            }):Play()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if dragStartPos and startButtonPos then
                local delta = input.Position - dragStartPos
                if delta.Magnitude > 10 then
                    movedFar = true
                end
                if movedFar then
                    local targetPos = UDim2.new(
                        startButtonPos.X.Scale,
                        startButtonPos.X.Offset + delta.X,
                        startButtonPos.Y.Scale,
                        startButtonPos.Y.Offset + delta.Y
                    )
                    btn.Position = targetPos
                end
            end
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if isDragging then
                isDragging = false

                TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.fromOffset(50, 50)
                }):Play()

                local dragDistance = dragStartPos and (input.Position - dragStartPos).Magnitude or 0
                local elapsed = os.clock() - pressStartTime

                -- Trigger toggle on tap/click (not dragging)
                if not movedFar and (dragDistance < 12 or elapsed < 0.28) then
                    ToggleHub()
                end

                dragStartPos = nil
                startButtonPos = nil
            end
        end
    end)

    return screenGui
end
