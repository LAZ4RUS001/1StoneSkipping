local WorldResolver = {}

function WorldResolver.GetCurrentWorld()
    local attr = LocalPlayer:GetAttribute("SkippingWorld")
    if attr and attr ~= "" then
        return attr
    end
    local worlds = workspace:FindFirstChild("SkippingWorlds")
    if worlds and #worlds:GetChildren() > 0 then
        return worlds:GetChildren()[1].Name
    end
    return "World1"
end

function WorldResolver.GetWorldObject()
    local worldName = WorldResolver.GetCurrentWorld()
    local worlds = workspace:FindFirstChild("SkippingWorlds")
    if worlds then
        return worlds:FindFirstChild(worldName) or worlds:GetChildren()[1]
    end
    return nil
end

function WorldResolver.GetLaunchZonePosition()
    local worldObj = WorldResolver.GetWorldObject()
    if worldObj then
        local launch = worldObj:FindFirstChild("LaunchZone")
        if launch then
            if launch:IsA("BasePart") then
                return launch.Position + Vector3.new(0, 1.5, 0)
            else
                return launch:GetPivot().Position + Vector3.new(0, 1.5, 0)
            end
        end
    end
    -- Fallback by world name
    local wName = WorldResolver.GetCurrentWorld()
    if wName == "World2" then
        return Vector3.new(12000, 4.5, -8)
    end
    return Vector3.new(0, 4.5, -7.6)
end

function WorldResolver.GetTrainingZones()
    local worldObj = WorldResolver.GetWorldObject()
    local zones = {}
    if worldObj then
        local tZones = worldObj:FindFirstChild("TrainingZones")
        if tZones then
            for _, z in ipairs(tZones:GetChildren()) do
                local pad = z:FindFirstChild("Pad") or z:FindFirstChild("Zone") or z:FindFirstChildWhichIsA("BasePart")
                local pos = pad and pad.Position or (z:IsA("Model") and z:GetPivot().Position)
                local req = 0
                local mult = "1x"
                local isRobux = false

                for _, desc in ipairs(z:GetDescendants()) do
                    if desc:IsA("TextLabel") then
                        local t = desc.Text
                        local r = t:match("^(%d+)$")
                        if r then req = tonumber(r) end
                        local m = t:match("(%d+x)%s*SKILL")
                        if m then mult = m end
                        if string.find(t, "ALL WORLDS") then
                            isRobux = true
                        end
                    end
                end

                if pos then
                    zones[z.Name] = {
                        Name = z.Name,
                        Position = pos,
                        RebirthReq = req,
                        Multiplier = mult,
                        IsRobux = isRobux
                    }
                end
            end
        end
    end
    return zones
end

function WorldResolver.GetBestRebirthZone()
    local rebirths = 0
    pcall(function()
        rebirths = LocalPlayer.leaderstats and tonumber(LocalPlayer.leaderstats.Rebirths.Value) or 0
    end)

    local zones = WorldResolver.GetTrainingZones()
    local bestZone = nil
    local maxReq = -1

    for _, z in pairs(zones) do
        if not z.IsRobux and rebirths >= z.RebirthReq and z.RebirthReq > maxReq then
            maxReq = z.RebirthReq
            bestZone = z
        end
    end

    if bestZone then
        return bestZone.Position, bestZone
    end

    -- Fallback by world
    local wName = WorldResolver.GetCurrentWorld()
    if wName == "World2" then
        return Vector3.new(11963.46, 5.5, -26.1), nil
    end
    return Vector3.new(-36.54, 5.5, -25.7), nil
end

function WorldResolver.GetEggStandPosition(eggName)
    local worldObj = WorldResolver.GetWorldObject()
    if worldObj then
        local eggShop = worldObj:FindFirstChild("EggShop")
        local displays = eggShop and eggShop:FindFirstChild("Displays")
        local eggModel = displays and displays:FindFirstChild(eggName)
        if eggModel then
            local pos = eggModel:GetPivot().Position
            return pos + Vector3.new(0, 1.2, 3.2)
        end
        if eggShop then
            return eggShop:GetPivot().Position + Vector3.new(0, 1.5, 0)
        end
    end

    -- Static Fallbacks
    local Fallbacks = {
        Common = Vector3.new(-15, 5.5, -96.6),
        Uncommon = Vector3.new(-11, 5.5, -104.6),
        Rare = Vector3.new(11, 5.5, -104.6),
        Special = Vector3.new(14.7, 5.5, -96.5),
        Epic = Vector3.new(11985, 5.5, -97),
        PirateSpecial = Vector3.new(12014.7, 5.5, -96.9),
