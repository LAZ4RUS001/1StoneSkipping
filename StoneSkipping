-- Native Throw Trigger Helper (Binds to game's internal Throw closure to play full cinematic cutscenes)
local function TriggerNativeThrow()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local hud = pg and pg:FindFirstChild("SkippingHUD")
    local bottom = hud and hud:FindFirstChild("HUD") and hud.HUD:FindFirstChild("Bottom")
    local throwBtn = bottom and bottom:FindFirstChild("Progression") and bottom.Progression:FindFirstChild("Throw")

    if throwBtn then
        -- Method 1: call game's native BeginThrow closure from upvalues so u34 and StoneView cutscene trigger properly
        local conns = getconnections and getconnections(throwBtn.Activated)
        if conns and #conns > 0 and conns[1].Function then
            local ups = debug.getupvalues(conns[1].Function)
            if type(ups[4]) == "table" and type(ups[4].BeginThrow) == "function" then
                ups[4].BeginThrow()
                return true
            end
        end

        -- Method 2: firesignal on Throw button
        if firesignal then
            firesignal(throwBtn.Activated)
            return true
        end
    end

    -- Method 3: Fallback direct network packet
    if Request then
        State.ThrowRequestId = State.ThrowRequestId + 1
        Request:FireServer("Throw", State.ThrowRequestId)
        return true
    end
    return false
end

-- 2. Auto Throw Thread (Multi-World LaunchZone Safe with Full Cutscene Support)
task.spawn(function()
    while Session.Running do
        task.wait(0.3)
        if State.AutoThrow and not State.AutoHatch then
            -- 1. วาร์ปเข้าสู่ LaunchZone ของ World ปัจจุบัน
            local launchPos = WorldResolver.GetLaunchZonePosition()
            SafeTeleport(launchPos)
            task.wait(0.15)

            -- 2. หากยังติดสถานะ Practice ให้หยุดก่อน และรอให้กลายเป็น Idle
            local act = LocalPlayer:GetAttribute("SkippingActivity")
            if act == "Practice" and Request then
                Request:FireServer("StopPractice", nil)
                local stopWait = 0
                repeat
                    task.wait(0.1)
                    stopWait = stopWait + 0.1
                    act = LocalPlayer:GetAttribute("SkippingActivity")
                until act ~= "Practice" or stopWait >= 1.0
            end

            -- 3. ตรวจสอบว่าพร้อมขว้างหรือไม่ (ต้องเป็นสถานะ Idle)
            act = LocalPlayer:GetAttribute("SkippingActivity")
            if act == "Idle" or act == nil then
                TriggerNativeThrow()

                -- 4. รอจนกว่าหินจะเริ่มบินและเข้าสู่สถานะ Throw
                local throwStart = os.clock()
                repeat
                    task.wait(0.1)
                    act = LocalPlayer:GetAttribute("SkippingActivity")
                until act == "Throw" or os.clock() - throwStart >= 2.0

                -- 5. ปล่อยให้ Cutscene แสดงเต็มรูปแบบ ติดตามหินกระดอนบนผิวน้ำจนจบ โดยไม่ปิดหรือตัดข้าม Cutscene
                if act == "Throw" then
                    repeat
                        task.wait(0.3)
                        act = LocalPlayer:GetAttribute("SkippingActivity")
                    until act ~= "Throw" or not State.AutoThrow

                    -- รอให้มุมกล้อง Reset กลับมายังตัวละครอย่างสมบูรณ์
                    local camWait = 0
                    while workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable and camWait < 2.0 do
                        task.wait(0.1)
                        camWait = camWait + 0.1
                    end
                end

                -- หน่วงเวลาตามที่ Kovak ปรับไว้ใน Slider
                task.wait(State.ThrowDelay or 1.0)
            end
        end
    end
end)

