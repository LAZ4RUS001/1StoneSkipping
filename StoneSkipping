local STREET_HUB_LOGO_B64 = [[]]

local function DecodeBase64(data)
    local b64decode = (crypt and (crypt.base64_decode or crypt.base64decode)) or base64_decode or (base64 and base64.decode)
    if b64decode then
        local ok, res = pcall(b64decode, data)
        if ok and res and #res > 0 then return res end
    end
    -- High performance Luau bit32 fallback decoder (<0.2ms for 4KB)
    local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, 64 do map[string.byte(b64chars, i)] = i - 1 end
    local clean = string.gsub(data, "[^A-Za-z0-9+/=]", "")
    local bytes = {}
    local len = #clean
    for i = 1, len, 4 do
        local c1, c2, c3, c4 = string.byte(clean, i, i + 3)
        local v1, v2, v3, v4 = map[c1] or 0, map[c2] or 0, map[c3] or 0, map[c4] or 0
        local n = bit32.bor(bit32.lshift(v1, 18), bit32.lshift(v2, 12), bit32.lshift(v3, 6), v4)
        table.insert(bytes, string.char(bit32.band(bit32.rshift(n, 16), 0xFF)))
        if c3 ~= 61 then table.insert(bytes, string.char(bit32.band(bit32.rshift(n, 8), 0xFF))) end
        if c4 ~= 61 then table.insert(bytes, string.char(bit32.band(n, 0xFF))) end
    end
    return table.concat(bytes)
end

local function GetStreetHubLogo()
    local logoFile = "streethub_logo.jpg"
    local getasset = getcustomasset or getsynasset

    pcall(function()
        if not (isfile and isfile(logoFile)) then
            if writefile then
                local rawBytes = DecodeBase64(STREET_HUB_LOGO_B64)
                if rawBytes and #rawBytes > 0 then
                    writefile(logoFile, rawBytes)
                end
            end
        end
    end)

    if getasset and isfile and isfile(logoFile) then
        local assetId = nil
        pcall(function()
            assetId = getasset(logoFile)
        end)
        -- Filter out empty or broken Delta hash stubs (e.g. rbxasset://%x%x%x%x)
        if assetId and type(assetId) == "string" and assetId ~= "" and not string.find(assetId, "rbxasset://%%x") then
            return assetId
        end
    end

    return ""
end

