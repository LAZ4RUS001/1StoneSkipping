local function LoadAutoSave()
    pcall(function()
        if isfile and isfile(AutoSavePath) then
            local raw = readfile(AutoSavePath)
            if raw and #raw > 5 then
                local data = HttpService:JSONDecode(raw)
                if type(data) == "table" then
                    for name, item in pairs(data) do
                        if AutoSaveWhitelist[name] then
                            local opt = Fluent.Options[name]
                            if opt and opt.SetValue and item.Value ~= nil then
                                pcall(function()
                                    opt:SetValue(item.Value)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

