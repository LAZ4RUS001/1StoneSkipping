        for name, opt in pairs(Fluent.Options) do
            if AutoSaveWhitelist[name] and (opt.Type == "Toggle" or opt.Type == "Slider" or opt.Type == "Dropdown") then
                data[name] = {
                    Type = opt.Type,
                    Value = opt.Value
                }
