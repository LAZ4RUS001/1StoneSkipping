    return Vector3.new(0, 5.5, -100.0)
end

-- Universal Rebirth Readiness Checker (Multiple redundant detectors across PC & Mobile)
local function CanPlayerRebirth()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local hud = pg and pg:FindFirstChild("SkippingHUD")
    if not hud then return false end

    -- 1. Inspect SideMenu Rebirth button progress (shows "100%" or "MAX" or "REBIRTH")
    local ok1, can1 = pcall(function()
        local left = hud:FindFirstChild("HUD") and hud.HUD:FindFirstChild("Left")
        local rebirthBtn = left and left:FindFirstChild("SideMenu") and left.SideMenu:FindFirstChild("RebirthSlot") and left.SideMenu.RebirthSlot:FindFirstChild("Rebirth")
        local prog = rebirthBtn and rebirthBtn:FindFirstChild("Progress")
        if prog and (prog.Text == "100%" or string.find(prog.Text, "100") or string.find(prog.Text:lower(), "max") or string.find(prog.Text:lower(), "ready")) then
            return true
        end
        return false
    end)
    if ok1 and can1 then return true end

    -- 2. Inspect Bottom HUD RebirthMessage
    local ok2, can2 = pcall(function()
        local bottom = hud:FindFirstChild("HUD") and hud.HUD:FindFirstChild("Bottom")
        local rebMsg = bottom and bottom:FindFirstChild("RebirthMessage", true)
        if rebMsg and rebMsg.Visible and rebMsg.Text ~= "" and string.find(rebMsg.Text:lower(), "rebirth") then
            return true
        end
        return false
    end)
    if ok2 and can2 then return true end

    -- 3. Inspect RebirthOverlay Requirement if opened
    local ok3, can3 = pcall(function()
        local overlay = hud:FindFirstChild("RebirthOverlay", true)
        local reqLabel = overlay and overlay:FindFirstChild("Requirement", true)
        if reqLabel and reqLabel.Text ~= "" then
            local cur, req = reqLabel.Text:match("Level%s*(%d+)%s*/%s*Level%s*(%d+)")
            if cur and req then
                return tonumber(cur) >= tonumber(req)
            end
        end
        return false
    end)
    if ok3 and can3 then return true end

    return false
end

-- Universal Pet Index Automation Helper (Reveals pending pets & claims tier rewards)
local function ProcessPetIndex()
    local didAction = false
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local hud = pg and pg:FindFirstChild("SkippingHUD")
        local indexPage = hud and hud:FindFirstChild("IndexPage", true)

        if indexPage then
            -- 1. Reveal all pending discovered pets to advance Index XP
            local claimAll = indexPage:FindFirstChild("ClaimAll")
            if claimAll and claimAll.Active then
                didAction = true
                if firesignal then
                    firesignal(claimAll.Activated)
                elseif getconnections then
                    for _, c in ipairs(getconnections(claimAll.Activated)) do
                        if c.Fire then c:Fire() elseif c.Function then c.Function() end
                    end
                end
            end

            -- 2. Claim unlocked Index milestone reward
            local reward = indexPage:FindFirstChild("Reward")
            local claim = reward and reward:FindFirstChild("Claim")
            if claim and claim.Active then
                didAction = true
                if firesignal then
                    firesignal(claim.Activated)
                elseif getconnections then
                    for _, c in ipairs(getconnections(claim.Activated)) do
                        if c.Fire then c:Fire() elseif c.Function then c.Function() end
                    end
                end
            end
        end

        -- 3. Direct network fallback to server
        if Request then
            Request:FireServer("ClaimPetIndex", nil)
        end
    end)
    return didAction
end

